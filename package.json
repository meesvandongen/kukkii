{
  "name": "kukkii",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/kukkii.git"
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/kukkii/issues"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "~20.19.0",
    "publint": "^0.3.25",
    "typescript": "~5.9.0",
    "vite-plus": "catalog:"
  },
  "sideEffects": [],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
