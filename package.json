{
  "name": "kukkii",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/kukkii.git"
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/kukkii/issues"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "~20.19.0",
    "publint": "^0.3.25",
    "typescript": "~5.9.0",
    "vite-plus": "catalog:"
  },
  "sideEffects": [],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
