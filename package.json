{
  "name": "kukkii",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/kukkii.git"
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/kukkii/issues"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "~20.19.0",
    "publint": "^0.3.25",
    "typescript": "~5.9.0",
    "vite-plus": "catalog:"
  },
  "sideEffects": [],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.20.0+sha512.6ccc74997ccef4e67999788e18dbfbfa583e2a849668668db4707b6a8306662f47156e650232a985bd3ec24cf9364c1aa154d37e51ed7aac62c1cd1e3afc80c3"
}
