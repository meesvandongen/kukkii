{
  "name": "kukkii",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/kukkii.git"
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/kukkii/issues"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "~20.19.0",
    "publint": "^0.3.25",
    "typescript": "~5.9.0",
    "vite-plus": "catalog:"
  },
  "sideEffects": [],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
