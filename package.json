  },
  "bugs": {
    "url": "https://github.com/meesvandongen/kukkii/issues"
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "~20.19.0",
    "publint": "^0.3.25",
    "typescript": "~5.9.0",
    "vite-plus": "catalog:"
  },
  "sideEffects": [],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
